        "<!DOCTYPE",
        "<html",
        "<body",
        "404 Not Found",
        "The requested URL was not found",
        "Apache/2.4.",
        "nginx",
        "Not Found",
        "403 Forbidden"
      ]
    },
    "confidence": 80
  },
  "sitemap": {
    "paths": ["/sitemap.xml"],
    "verification": {
      "method": "content",
      "patterns": ["<urlset", "<url>", "<loc>", "xmlns="],
      "must_have": [],
      "must_not_have": [
        "<!DOCTYPE",
        "<html",
        "<body",
        "404 Not Found",
        "The requested URL was not found",
        "Apache/2.4.",
        "nginx",
        "Not Found",
        "403 Forbidden"
