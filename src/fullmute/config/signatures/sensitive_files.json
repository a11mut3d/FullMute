{
  "git_head": {
    "paths": ["/.git/HEAD"],
    "verification": {
      "method": "content",
      "patterns": ["ref: refs/"],
      "must_have": ["ref:"],
      "must_not_have": [
        "<!DOCTYPE",
        "<html",
        "<body",
        "404 Not Found",
        "The requested URL was not found",
        "Apache/2.4.",
        "nginx",
        "Not Found",
        "403 Forbidden"
      ]
    },
    "confidence": 95
  },
  "git_config": {
    "paths": ["/.git/config"],
    "verification": {
      "method": "content",
      "patterns": ["\\[core\\]", "repositoryformatversion"],
      "must_have": ["[core]", "repositoryformatversion"],
      "must_not_have": [
        "<!DOCTYPE",
        "<html",
        "<body",
        "404 Not Found",
        "The requested URL was not found",
        "Apache/2.4.",
        "nginx",
        "Not Found",
        "403 Forbidden"
      ]
    },
    "confidence": 95
  },
  "git_exposed": {
    "paths": ["/.git/"],
    "verification": {
      "method": "directory_listing",
      "patterns": ["HEAD", "config", "index", "objects", "refs"],
      "must_have": [],
      "must_not_have": [
        "forbidden",
        "not found",
        "404",
        "403",
        "denied",
        "Apache/2.4.",
        "nginx"
      ]
    },
    "confidence": 90
  },
  "env_files": {
    "paths": ["/.env", "/.env.local", "/.env.production", "/.env.dev"],
    "verification": {
      "method": "content",
      "patterns": ["^[A-Z_]+=", "^DB_", "^APP_", "^SECRET_"],
      "must_have": [],
      "must_not_have": [
        "<!DOCTYPE",
        "<html",
        "<body",
        "404 Not Found",
        "The requested URL was not found",
        "Apache/2.4.",
        "nginx",
        "Not Found",
        "403 Forbidden"
      ]
    },
    "confidence": 95
  },
  "config_php": {
    "paths": ["/config.php", "/configuration.php", "/wp-config.php"],
    "verification": {
      "method": "content",
      "patterns": ["<?php", "define\\(", "\\$database", "\\$password"],
      "must_have": ["<?php"],
      "must_not_have": [
        "<!DOCTYPE",
        "<html",
        "<body",
        "404 Not Found",
        "The requested URL was not found",
        "Apache/2.4.",
        "nginx",
        "Not Found",
        "403 Forbidden"
      ]
    },
    "confidence": 90
  },
  "backup_files": {
    "paths": ["/backup.sql", "/dump.sql", "/database.sql"],
    "verification": {
      "method": "content",
      "patterns": ["CREATE TABLE", "INSERT INTO", "DROP TABLE", "-- MySQL dump", "-- PostgreSQL database dump"],
      "must_have": [],
      "must_not_have": [
        "<!DOCTYPE",
        "<html",
        "<body",
        "404 Not Found",
        "The requested URL was not found",
        "Apache/2.4.",
        "nginx",
        "Not Found",
        "403 Forbidden"
      ]
    },
    "confidence": 90
  },
  "log_files": {
    "paths": ["/error.log", "/debug.log"],
    "verification": {
      "method": "content",
      "patterns": ["\\[.*\\].*ERROR", "\\[.*\\].*WARNING", "Exception", "Stack trace", "Fatal error"],
      "must_have": [],
      "must_not_have": [
        "<!DOCTYPE",
        "<html",
        "<body",
        "404 Not Found",
        "The requested URL was not found",
        "Apache/2.4.",
        "nginx",
        "Not Found",
        "403 Forbidden"
      ]
    },
    "confidence": 85
  },
  "admin_panels": {
    "paths": ["/admin/", "/wp-admin/", "/administrator/"],
    "verification": {
      "method": "login_form",
      "patterns": ["<form", "password", "username", "login"],
      "must_have": [],
      "must_not_have": [
        "forbidden",
        "access denied",
        "403",
        "401",
        "404 Not Found",
        "The requested URL was not found",
        "Apache/2.4.",
        "nginx"
      ]
    },
    "confidence": 75
  },
  "htaccess": {
    "paths": ["/.htaccess"],
    "verification": {
      "method": "content",
      "patterns": ["RewriteEngine", "RewriteRule", "RewriteCond", "Deny from", "Allow from"],
      "must_have": [],
