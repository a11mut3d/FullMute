{
  "git_config": {
    "paths": ["/.git/HEAD", "/.git/config", "/.git/index"],
    "verification": {
      "method": "content",
      "patterns": ["ref: refs/", "\\[core\\]", "repositoryformatversion"],
      "must_have": ["ref:", "refs/", "[core]", "repositoryformatversion"],
      "must_not_have": ["<!DOCTYPE", "<html", "<body", "<!doctype"]
    },
    "confidence": 95
  },
  "git_exposed": {
    "paths": ["/.git/"],
    "verification": {
      "method": "directory_listing",
      "patterns": ["HEAD", "config", "index", "objects", "refs"],
      "must_have": ["HEAD", "config", "index", "objects", "refs"],
      "must_not_have": ["forbidden", "not found", "404", "403"]
    },
    "confidence": 90
  },
  "env_files": {
    "paths": ["/.env", "/.env.local", "/.env.production", "/.env.dev"],
    "verification": {
      "method": "content",
      "patterns": ["^[A-Z_]+=", "^DB_", "^APP_", "^SECRET_"],
      "must_have": ["=", "KEY", "SECRET", "PASSWORD", "DB_", "APP_"],
      "must_not_have": ["<!DOCTYPE", "<html", "<body", "Not Found", "404", "403"]
    },
    "confidence": 95
  },
  "config_php": {
    "paths": ["/config.php", "/configuration.php", "/wp-config.php"],
    "verification": {
      "method": "content",
      "patterns": ["<?php", "define\\(", "\\$database", "\\$password"],
      "must_have": ["<?php", "define(", "$"],
      "must_not_have": ["<!DOCTYPE", "<html", "<body", "Page not found", "404"]
    },
    "confidence": 90
  },
  "backup_files": {
    "paths": ["/backup.sql", "/dump.sql", "/database.sql"],
    "verification": {
      "method": "content",
      "patterns": ["CREATE TABLE", "INSERT INTO", "DROP TABLE", "-- MySQL dump", "-- PostgreSQL database dump"],
      "must_have": ["CREATE", "TABLE", "INSERT", "INTO"],
      "must_not_have": ["<!DOCTYPE", "<html", "<body", "Page not found", "404"]
    },
    "confidence": 90
  },
  "log_files": {
    "paths": ["/error.log", "/debug.log"],
    "verification": {
      "method": "content",
      "patterns": ["\\[.*\\].*ERROR", "\\[.*\\].*WARNING", "Exception", "Stack trace", "Fatal error"],
      "must_have": ["[", "]", "ERROR", "WARNING", "Exception", "Stack"],
      "must_not_have": ["<!DOCTYPE", "<html", "<body", "Page not found", "404"]
    },
    "confidence": 85
  },
  "admin_panels": {
    "paths": ["/admin/", "/wp-admin/", "/administrator/"],
    "verification": {
      "method": "login_form",
      "patterns": ["<form", "password", "username", "login"],
      "must_have": ["<form", "password", "username", "login"],
      "must_not_have": ["forbidden", "access denied", "403", "401"]
    },
    "confidence": 75
  },
  "htaccess": {
    "paths": ["/.htaccess"],
    "verification": {
      "method": "content",
      "patterns": ["RewriteEngine", "RewriteRule", "RewriteCond", "Deny from", "Allow from"],
      "must_have": ["Rewrite", "Deny", "Allow"],
      "must_not_have": ["<!DOCTYPE", "<html", "<body", "Page not found", "404"]
    },
    "confidence": 90
  },
  "robots_txt": {
    "paths": ["/robots.txt"],
    "verification": {
      "method": "content",
      "patterns": ["User-agent:", "Disallow:", "Allow:", "Sitemap:"],
      "must_have": ["User-agent", "Disallow"],
      "must_not_have": ["<!DOCTYPE", "<html", "<body", "Page not found", "404"]
    },
    "confidence": 80
  },
  "sitemap": {
    "paths": ["/sitemap.xml"],
    "verification": {
      "method": "content",
      "patterns": ["<urlset", "<url>", "<loc>", "xmlns="],
      "must_have": ["<urlset", "<url>", "<loc>"],
      "must_not_have": ["<!DOCTYPE", "<html", "<body", "Page not found", "404"]
    },
    "confidence": 85
  }
}
