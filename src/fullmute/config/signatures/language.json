{
  "PHP": {
    "headers": [
      "X-Powered-By:\\s*PHP(?:/[0-9.]+)?",
      "Server:.*\\bPHP\\b",
      "Set-Cookie:.*\\bPHPSESSID\\b"
    ],
    "html": [
      "<\\?php",
      "\\bPHPSESSID\\b",
      "wp-content/(?:themes|plugins)/",
      "wp-includes/",
      "\\bphpinfo\\s*\\(\\)",
      "\\$_GET\\b",
      "\\$_POST\\b",
      "\\$_SESSION\\b",
      "\\$_COOKIE\\b",
      "\\brequire_once\\b",
      "\\binclude_once\\b",
      "\\bmysqli?_\\w+\\s*\\("
    ],
    "urls": [
      "\\.php(?:$|[?#])",
      "\\.php[345](?:$|[?#])",
      "\\.phtml(?:$|[?#])"
    ],
    "cookies": ["^PHPSESSID$", "^php"],
    "version_pattern": "PHP/([0-9]+(?:\\.[0-9]+)*)",
    "must_have": [
      "X-Powered-By:\\s*PHP",
      "\\bPHPSESSID\\b",
      "<\\?php",
      "href=[\"'][^\"']*\\.php"
    ],
    "must_not_have": [
      "X-Powered-By:\\s*(?:ASP\\.NET|Express|Servlet)",
      "Server:.*\\bApache-Coyote\\b"
    ]
  },

  "Python": {
    "headers": [
      "X-Powered-By:\\s*Python",
      "Server:.*\\b(?:Werkzeug|gunicorn|uvicorn)\\b",
      "Server:.*\\bPython\\b"
    ],
    "html": [
      "\\bimport\\s+[a-zA-Z_]\\w*",
      "\\bfrom\\s+[a-zA-Z_]\\w*\\s+import\\b",
      "\\bdef\\s+[a-zA-Z_]\\w*\\s*\\([^)]*\\)\\s*:",
      "\\bclass\\s+[a-zA-Z_]\\w*\\s*(?:\\([^)]*\\))?\\s*:",
      "\\bif\\s+__name__\\s*==\\s*[\"']__main__[\"']\\s*:",
      "\\b(?:django|flask|fastapi|tornado|aiohttp)\\b"
    ],
    "urls": [
      "\\.py(?:$|[?#])",
      "/django(?:/|$)",
      "/flask(?:/|$)"
    ],
    "cookies": ["^csrftoken$", "^sessionid$"],
    "version_pattern": "Python/([0-9]+(?:\\.[0-9]+)*)",
    "must_have": [
      "X-Powered-By:\\s*Python",
      "Server:.*\\b(?:Werkzeug|gunicorn|uvicorn)\\b",
      "\\bif\\s+__name__\\s*==\\s*[\"']__main__[\"']\\s*:",
      "href=[\"'][^\"']*\\.py(?:$|[?#\"'])"
    ],
    "must_not_have": [
      "X-Powered-By:\\s*PHP",
      "X-Powered-By:\\s*ASP\\.NET",
      "X-Powered-By:\\s*Express"
    ]
  },

  "Java": {
    "headers": [
      "X-Powered-By:\\s*(?:Servlet|JSP|Java)",
      "Server:.*\\bApache-Coyote\\b",
      "X-Application-Context",
      "Set-Cookie:.*\\bJSESSIONID\\b"
    ],
    "html": [
      "\\bimport\\s+java\\.",
      "\\bpublic\\s+(?:final\\s+)?class\\s+\\w+",
      "\\bHttpServletRequest\\b",
      "\\bHttpServletResponse\\b",
      "\\bjsp:\\w+",
      "<%[=@!]?"
    ],
    "urls": [
      "\\.jspx?(?:$|[?#])",
      "\\.jws(?:$|[?#])",
      "/servlet(?:/|$)"
    ],
    "cookies": ["^JSESSIONID$"],
    "version_pattern": "Java/([0-9]+(?:\\.[0-9]+)*)",
    "must_have": [
      "X-Powered-By:\\s*(?:Servlet|JSP|Java)",
      "Server:.*\\bApache-Coyote\\b",
      "\\bJSESSIONID\\b",
      "href=[\"'][^\"']*\\.jspx?"
    ],
    "must_not_have": [
      "X-Powered-By:\\s*PHP",
      "X-Powered-By:\\s*Express"
    ]
  },

  "Node.js": {
    "headers": [
      "X-Powered-By:\\s*Express",
      "X-Powered-By:\\s*Node(?:\\.js)?",
      "Server:.*\\bNode(?:\\.js)?\\b",
      "Set-Cookie:.*\\bconnect\\.sid\\b"
    ],
    "html": [
      "\\bmodule\\.exports\\b",
      "\\bexports\\.\\w+",
      "\\brequire\\s*\\(\\s*[\"'][^\"']+[\"']\\s*\\)",
      "\\bapp\\.(?:get|post|put|delete|use)\\s*\\(",
      "\\bapp\\.listen\\s*\\(",
      "\\bsocket\\.io\\b"
    ],
    "urls": [
      "/package\\.json(?:$|[?#])",
      "/socket\\.io(?:/|$)",
      "/node(?:/|$)"
    ],
    "cookies": ["^connect\\.sid$", "^node_session$"],
    "version_pattern": "Node(?:\\.js)?/([0-9]+(?:\\.[0-9]+)*)",
    "must_have": [
      "X-Powered-By:\\s*Express",
      "X-Powered-By:\\s*Node(?:\\.js)?",
      "\\bconnect\\.sid\\b",
      "/package\\.json",
      "/socket\\.io"
    ],
    "must_not_have": [
      "X-Powered-By:\\s*PHP",
      "X-Powered-By:\\s*ASP\\.NET",
      "Server:.*\\bApache-Coyote\\b"
    ]
  },

  "Ruby": {
    "headers": [
      "X-Powered-By:\\s*(?:Phusion Passenger|Ruby)",
      "X-Runtime:"
    ],
    "html": [
      "\\brequire\\s+[\"'][^\"']+[\"']",
      "\\bRails\\.",
      "<%=.*?%>",
      "\\b(?:erb|haml|slim)\\b"
    ],
    "urls": [
      "\\.rb(?:$|[?#])",
      "\\.rhtml(?:$|[?#])",
      "/rails(?:/|$)"
    ],
    "cookies": ["^_rails_session$", "^rack\\.session$"],
    "version_pattern": "Ruby/([0-9]+(?:\\.[0-9]+)*)",
    "must_have": [
      "X-Powered-By:\\s*(?:Phusion Passenger|Ruby)",
      "X-Runtime:",
      "\\b_rails_session\\b",
      "href=[\"'][^\"']*\\.rb(?:$|[?#\"'])"
    ],
    "must_not_have": [
      "X-Powered-By:\\s*PHP",
      "X-Powered-By:\\s*Express"
    ]
  },

  "Go": {
    "headers": [
      "X-Powered-By:\\s*Go",
      "Server:.*\\bGo(?:-http)?\\b"
    ],
    "html": [
      "\\bpackage\\s+main\\b",
      "\\bfunc\\s+\\w+\\s*\\(",
      "\\bnet/http\\b",
      "\\bfmt\\.\\w+",
      "\\bgo\\s+func\\s*\\("
    ],
    "urls": [
      "\\.go(?:$|[?#])",
      "/golang(?:/|$)"
    ],
    "cookies": ["^go_session$"],
    "version_pattern": "Go/([0-9]+(?:\\.[0-9]+)*)",
    "must_have": [
      "X-Powered-By:\\s*Go",
      "Server:.*\\bGo(?:-http)?\\b",
      "\\bpackage\\s+main\\b",
      "href=[\"'][^\"']*\\.go(?:$|[?#\"'])"
    ],
    "must_not_have": [
      "X-Powered-By:\\s*PHP",
      "X-Powered-By:\\s*Express"
    ]
  },

  "C#": {
    "headers": [
      "X-Powered-By:\\s*ASP\\.NET",
      "X-AspNet-Version:",
      "X-AspNetMvc-Version:"
    ],
    "html": [
      "\\busing\\s+System(?:\\.\\w+)*\\s*;",
      "\\bnamespace\\s+[A-Za-z_]\\w*",
      "\\bPage_Load\\s*\\(",
      "\\b(?:Response|Request)\\.\\w+"
    ],
    "urls": [
      "\\.aspx(?:$|[?#])",
      "\\.ashx(?:$|[?#])",
      "\\.asmx(?:$|[?#])",
      "\\.ascx(?:$|[?#])",
      "\\.cshtml(?:$|[?#])"
    ],
    "cookies": ["^ASP\\.NET_SessionId$", "^ASPSESSION"],
    "version_pattern": "(?:ASP\\.NET|C#)/([0-9]+(?:\\.[0-9]+)*)",
    "must_have": [
      "X-Powered-By:\\s*ASP\\.NET",
      "X-AspNet-Version:",
      "ASP\\.NET_SessionId",
      "href=[\"'][^\"']*\\.aspx"
    ],
    "must_not_have": [
      "X-Powered-By:\\s*PHP",
      "X-Powered-By:\\s*Express"
    ]
  },

  "Perl": {
    "headers": [
      "X-Powered-By:\\s*Perl",
      "X-Generator:\\s*Perl"
    ],
    "html": [
      "#!/usr/bin/(?:env\\s+)?perl",
      "\\buse\\s+strict\\s*;",
      "\\buse\\s+warnings\\s*;",
      "\\bmy\\s+\\$\\w+",
      "\\bsub\\s+\\w+\\s*\\{"
    ],
    "urls": [
      "\\.pl(?:$|[?#])",
      "\\.pm(?:$|[?#])",
      "\\.cgi(?:$|[?#])"
    ],
    "cookies": ["^perl_session$"],
    "version_pattern": "Perl/([0-9]+(?:\\.[0-9]+)*)",
    "must_have": [
      "X-Powered-By:\\s*Perl",
      "#!/usr/bin/(?:env\\s+)?perl",
      "\\buse\\s+strict\\s*;",
      "href=[\"'][^\"']*\\.(?:pl|cgi|pm)(?:$|[?#\"'])"
    ],
    "must_not_have": [
      "X-Powered-By:\\s*PHP",
      "X-Powered-By:\\s*Express"
    ]
  }
}
